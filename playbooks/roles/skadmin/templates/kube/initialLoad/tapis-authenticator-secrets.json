{
    "secrets": {
        "servicepwd":[
            {
                "tenant":     "{{skadmin_service_tenant_id}}",
                "user":       "authenticator",
                "secretName": "password",
                "password":   "<generate-secret>",
                "kubeSecretName": "tapis-authenticator-secrets",
                "kubeSecretKey":  "service-password"
            }
        ],
        "user":[
            {
                "tenant":     "{{skadmin_service_tenant_id}}",
                "user":       "authenticator",
                "secretName": "ldap.tapis-dev",
                "key":        "password",
                "value":      "<generate-secret>",
                "kubeSecretName": "tapis-authenticator-secrets",
                "kubeSecretKey":  "dev-ldap-bind-credential"
            }        
        ],
        "dbcredential":[
            {
                "tenant":     "{{skadmin_service_tenant_id}}",
                "user":       "authenticator",
                "secretName": "passwords",
                "dbservice":  "postgres",
                "dbhost":     "postgres",
                "dbname":     "authenticator",
                "secret":     "<generate-secret>",
                "kubeSecretName": "tapis-authenticator-secrets",
                "kubeSecretKey":  "postgres-password"
            }
        ],
        "AUTHENTICATOR_APP_SECRET_KEY":[
            {
                "tenant":     "{{skadmin_service_tenant_id}}",
                "user":       "authenticator",
                "secretName": "app.secret-key",
                "secret":     "<generate-secret>",
                "kubeSecretName": "tapis-authenticator-secrets",
                "kubeSecretKey":  "AUTHENTICATOR_APP_SECRET_KEY"
            }

        ]
    }
}
